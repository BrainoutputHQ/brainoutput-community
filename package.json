{
  "name": "brainoutput-community",
  "version": "0.4.0",
  "description": "BrainOutput Community Edition — a configurable, token-efficient AI company that runs on your own free / local / BYOK models. Open source, zero-dependency, and yours to self-host.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "bo-community": "./bo-community.mjs"
  },
  "scripts": {
    "setup": "node bo-community.mjs setup",
    "serve": "node web-server.mjs",
    "onboard": "node bo-ce-onboard.mjs",
    "demo": "node bo-ce.mjs",
    "store": "node bo-ce-store.mjs",
    "test": "node --test *.test.mjs",
    "smoke:community-clean": "node smoke-clean.mjs"
  },
  "files": [
    "*.mjs",
    "install.sh",
    "samples",
    "demo",
    "*.md"
  ],
  "keywords": [
    "ai-company",
    "local-llm",
    "byok",
    "ollama",
    "opencode",
    "zero-cost"
  ]
}
